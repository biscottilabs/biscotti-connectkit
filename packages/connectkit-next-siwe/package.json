{
  "name": "biscotti-finance-connectkit-next-siwe",
  "version": "0.4.0",
  "author": "Biscotti Finance",
  "homepage": "https://github.com/biscottilabs/biscotti-connectkit",
  "license": "BSD-2-Clause",
  "description": "Connecting a wallet, made simple.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biscottilabs/biscotti-connectkit.git",
    "directory": "packages/connectkit-next-siwe"
  },
  "type": "module",
  "exports": {
    "./client": {
      "types": "./build/client.d.ts",
      "import": "./build/client.es.js",
      "default": "./build/client.es.js"
    },
    "./server": {
      "types": "./build/server.d.ts",
      "import": "./build/server.es.js",
      "default": "./build/server.es.js"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "./build/client.d.ts"
      ],
      "server": [
        "./build/server.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=12.4"
  },
  "files": [
    "build",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "rollup --config rollup.config.dev.js -w",
    "dev": "rollup --config rollup.config.dev.js -w",
    "build": "rm -rf build && rollup --config rollup.config.prod.js",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "ens",
    "react-hook",
    "blockchain",
    "hooks",
    "ethereum",
    "react"
  ],
  "dependencies": {
    "iron-session": "^6.2.1"
  },
  "peerDependencies": {
    "biscotti-finance-connectkit": ">=1.2.0",
    "next": ">=12.x",
    "react": "17.x || 18.x",
    "react-dom": "17.x || 18.x",
    "viem": ">=2.13.3"
  },
  "devDependencies": {
    "biscotti-finance-connectkit": "workspace:packages/connectkit",
    "@types/node": "^16.11.27",
    "@types/react": "^18.0.6",
    "@types/react-dom": "^18.0.2",
    "typescript": "5.3.3"
  }
}
