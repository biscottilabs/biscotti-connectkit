VITE_ALCHEMY_ID=
VITE_INFURA_ID=
VITE_WALLETCONNECT_PROJECT_ID=

# Circle environment: "sandbox" provisions Arc Testnet wallets; "live"
# provisions Base mainnet wallets. The API key, App ID, and chain must match.
VITE_CIRCLE_ENVIRONMENT=sandbox

# Public values included in the browser bundle.
VITE_CIRCLE_APP_ID=
VITE_GOOGLE_CLIENT_ID=

# Server-only. Never rename this to VITE_CIRCLE_API_KEY or commit a real key.
CIRCLE_API_KEY=
