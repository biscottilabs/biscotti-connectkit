NEXT_PUBLIC_ALCHEMY_ID=
NEXT_PUBLIC_INFURA_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
SESSION_SECRET=

# --- Sign in with Circle (user-controlled wallets) ---------------------------
# Leave these blank to keep the Circle login disabled.

# Circle Developer Console -> your app. Public; safe in the browser bundle.
NEXT_PUBLIC_CIRCLE_APP_ID=

# Google Cloud -> Credentials -> OAuth 2.0 Client ID, type "Web application".
# Public by design. Add your dev origin (e.g. http://localhost:3000) to that
# client's *Authorized redirect URIs*, or Google will reject the login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Circle Developer Console -> API Keys. Use a SANDBOX key for development.
# Server-side only: this grants full control of your Circle account, so it must
# never be given a NEXT_PUBLIC_ prefix.
CIRCLE_API_KEY=

# The Google client *secret* is NOT listed here on purpose. It belongs in the
# Circle Developer Console's social login settings, never in this file.
