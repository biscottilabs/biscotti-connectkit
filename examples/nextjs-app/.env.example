NEXT_PUBLIC_ALCHEMY_ID=
NEXT_PUBLIC_INFURA_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
SESSION_SECRET=

# --- Sign in with Circle (user-controlled wallets) ---------------------------
# Leave blank to keep Circle disabled. Testnet and mainnet are separate Circle
# environments, each with its own App ID and API key.

# "testnet" or "mainnet": which environment this deployment uses.
NEXT_PUBLIC_CIRCLE_ENVIRONMENT=testnet

# Circle Console -> Wallets -> User Controlled -> Configurator (per environment).
NEXT_PUBLIC_CIRCLE_TESTNET_APP_ID=
NEXT_PUBLIC_CIRCLE_MAINNET_APP_ID=

# Google Cloud OAuth 2.0 Web client. Register http://localhost:3000 as a
# redirect URI. The client secret belongs in Circle Console, not here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server only, never NEXT_PUBLIC_. TEST_API_KEY:... and LIVE_API_KEY:...
CIRCLE_TESTNET_API_KEY=
CIRCLE_MAINNET_API_KEY=
