{
  "name": "biscotti-finance-connectkit-monorepo",
  "version": "0.0.0",
  "description": "Biscotti Finance ConnectKit",
  "main": "packages/connectkit/src/index.ts",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:connectkit": "bun --filter biscotti-finance-connectkit dev",
    "dev:connectkit-next-siwe": "bun --filter biscotti-finance-connectkit-next-siwe dev",
    "dev:nextjs": "bun --filter nextjs dev",
    "dev:nextjs-app": "bun --filter nextjs-app dev",
    "dev:nextjs-siwe": "bun --filter nextjs-siwe dev",
    "dev:vite": "bun --filter vite-example dev",
    "dev:testbench": "bun --filter testbench dev",
    "build": "bun run build.js && bun --filter biscotti-finance-connectkit build && cp README.md packages/connectkit/README.md",
    "build:connectkit-next-siwe": "bun --filter biscotti-finance-connectkit-next-siwe build",
    "build:nextjs": "bun run build && bun --filter nextjs build",
    "build:nextjs-app": "bun run build && bun --filter nextjs-app build",
    "build:nextjs-siwe": "bun run build && bun --filter nextjs-siwe build",
    "build:vite": "bun run build && bun --filter vite-example build",
    "build:testbench": "bun run build && bun run build:connectkit-next-siwe && bun --filter testbench build",
    "build:examples": "bun run scripts/build-examples.mjs",
    "build:ci": "bun run build.js && bun run --filter biscotti-finance-connectkit build && bun run --filter biscotti-finance-connectkit-next-siwe build && bun run build:examples && cp README.md packages/connectkit/README.md",
    "build:all": "bun run build:ci",
    "lint:ci": "bun run --filter '*' --if-present lint",
    "lint:all": "bun run lint:ci"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "8.57.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rollup": "^2.80.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.34.0",
    "rollup-plugin-visualizer": "^5.5.4",
    "tslib": "^1.9.3",
    "typescript": "5.3.3",
    "typescript-plugin-styled-components": "^2.0.0",
    "viem": "^2.23.2",
    "wagmi": "^2.14.11"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@changesets/cli": "^2.24.4"
  },
  "overrides": {
    "@wagmi/core": "2.16.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "viem": "2.23.2",
    "wagmi": "2.14.11",
    "eslint-config-next": "15.5.14",
    "@wagmi/connectors": "5.7.7",
    "vite": "3.2.8",
    "webpack-dev-middleware": "5.3.4",
    "braces": "3.0.3",
    "cross-spawn": "6.0.6",
    "glob": "10.5.0",
    "nth-check": "2.0.1",
    "http-proxy-middleware": "2.0.9",
    "path-to-regexp": "0.1.12",
    "underscore": "1.13.8",
    "body-parser": "1.20.3",
    "ws": "8.17.1",
    "node-forge": "1.3.2",
    "tar": "7.5.11",
    "typescript": "5.3.3",
    "serialize-javascript": "7.0.3",
    "minimatch": "3.1.4"
  }
}
